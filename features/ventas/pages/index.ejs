<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Punto de Venta | Periféricos</title>
  <link rel="stylesheet" href="/css/tailwind.css"/>
  <link rel="stylesheet" href="/css/custom.css"/>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-50 font-sans text-gray-900 overflow-hidden flex h-screen selection:bg-indigo-200">

  <%- include('../../../shared/components/loader') %>

  <!-- Sidebar -->
  <aside class="w-64 bg-gray-900 text-white flex flex-col hidden lg:flex shadow-2xl relative z-20">
    <div class="h-20 flex items-center px-8 border-b border-gray-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-500 flex items-center justify-center font-bold text-xl shadow-lg shadow-emerald-500/20">PA</div>
        <span class="font-bold text-lg tracking-tight">Periféricos</span>
      </div>
    </div>
    
    <div class="flex-1 overflow-y-auto py-8 px-4">
      <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Menú Principal</p>
      <nav class="space-y-2">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-gray-800 hover:text-white transition-all font-medium group">
          <svg class="w-5 h-5 group-hover:text-indigo-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          Dashboard
        </a>
        <a href="/ventas" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-600 text-white shadow-md shadow-emerald-600/20 transition-all font-medium">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          Punto de Venta
        </a>
      </nav>
      
      <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-widest mt-10 mb-4">Cuenta</p>
      <nav class="space-y-2">
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-red-500/10 hover:text-red-400 transition-all font-medium group">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Cerrar Sesión
        </a>
      </nav>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
    
    <!-- Topbar -->
    <header class="h-20 bg-white/80 backdrop-blur-md border-b border-gray-200 flex items-center justify-between px-8 sticky top-0 z-10">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Punto de Venta</h1>
        <p class="text-sm text-gray-500 font-medium mt-0.5">Catálogo y Carrito</p>
      </div>
    <div class="flex items-center gap-3">
      <button id="dark-mode-toggle" title="Modo oscuro"
        class="w-10 h-10 rounded-xl border border-gray-200 bg-white/70 hover:bg-gray-100 text-gray-600 flex items-center justify-center transition-all shadow-sm hover:-translate-y-0.5">
        <svg id="icon-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
        </svg>
        <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12H3m15.07-6.07-.71.71M6.64 17.36l-.71.71M17.36 17.36l.71.71M6.64 6.64l.71.71M12 7a5 5 0 100 10A5 5 0 0012 7z"/>
        </svg>
      </button>
      <div class="flex items-center gap-2 px-4 py-2 bg-emerald-50 rounded-xl border border-emerald-100">
        <span class="text-sm font-semibold text-emerald-700">🛒</span>
        <span id="badge-carrito" class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-bold">0</span>
      </div>
    </div>
    </header>

    <!-- Content Area -->
    <main class="flex-1 overflow-y-auto p-8">
      
      <!-- Toasts -->
      <% if (toast_ok) { %>
        <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-4 rounded-2xl shadow-sm flex items-start gap-3 animate-[slideInRight_0.3s_ease-out]" role="status">
          <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <p class="text-sm font-medium pt-1"><%= toast_ok %></p>
        </div>
      <% } %>
      <% if (toast_warn) { %>
        <div class="mb-6 bg-amber-50 border border-amber-200 text-amber-800 px-5 py-4 rounded-2xl shadow-sm flex items-start gap-3 animate-[slideInRight_0.3s_ease-out]" role="status">
          <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <p class="text-sm font-medium pt-1"><%= toast_warn %></p>
        </div>
      <% } %>

      <!-- Tabs -->
      <div class="flex gap-2 border-b border-gray-200 mb-8">
        <button id="tab-nueva" onclick="cambiarTab('nueva')" class="px-6 py-3 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 transition-colors">➕ Nueva venta</button>
        <button id="tab-historial" onclick="cambiarTab('historial')" class="px-6 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors">📋 Historial</button>
      </div>

      <!-- NUEVA VENTA PANEL -->
      <div id="panel-nueva" class="block">
        
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
          
          <!-- Lado izquierdo: Catálogo -->
          <div class="xl:col-span-2 space-y-6">
            
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest flex items-center gap-2 mb-4">
                <span class="w-1 h-4 bg-emerald-500 rounded-full"></span> 📦 Seleccionar Productos
              </h3>
              
              <div class="relative mb-4">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <input type="text" id="buscar" oninput="renderGrid()" placeholder="Buscar por nombre, marca o categoría..." 
                  class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all outline-none">
              </div>

              <div id="cat-pills" class="flex flex-wrap gap-2 mb-6"></div>

              <div id="pgrid" class="grid grid-cols-2 md:grid-cols-3 gap-4 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar"></div>
            </div>

          </div>

          <!-- Lado derecho: Carrito y Checkout -->
          <div class="space-y-6">
            
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sticky top-24">
              
              <!-- Datos del cliente -->
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest flex items-center gap-2 mb-4">
                <span class="w-1 h-4 bg-emerald-500 rounded-full"></span> 👤 Datos del Cliente
              </h3>
              
              <div class="space-y-4 mb-6">
                <div>
                  <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Nombre *</label>
                  <input type="text" id="cli-nombre" placeholder="Ej: Juan Pérez" class="w-full px-4 py-2.5 rounded-lg border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none transition-all text-sm">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Notas (Opcional)</label>
                  <input type="text" id="cli-notas" placeholder="Observaciones" class="w-full px-4 py-2.5 rounded-lg border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none transition-all text-sm">
                </div>
              </div>

              <div class="border-t border-gray-100 my-6"></div>

              <!-- Carrito -->
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest flex items-center gap-2">
                  <span class="w-1 h-4 bg-emerald-500 rounded-full"></span> 🧾 Carrito
                </h3>
                <button onclick="vaciarCarrito()" class="text-xs font-medium text-gray-400 hover:text-red-500 transition-colors">Vaciar</button>
              </div>

              <div id="cart-empty" class="text-center py-8 text-sm text-gray-400 font-medium">
                Selecciona productos del catálogo
              </div>

              <div id="cart-body" class="space-y-3 mb-6 max-h-[250px] overflow-y-auto pr-2 custom-scrollbar"></div>

              <!-- Resumen -->
              <div id="resumen" style="display:none;" class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                <div class="flex justify-between text-sm text-gray-500 mb-2">
                  <span>Subtotal</span><span id="r-sub" class="font-medium text-gray-900">S/ 0.00</span>
                </div>
                <div class="flex justify-between text-sm text-gray-500 mb-4">
                  <span>IGV (18%)</span><span id="r-igv" class="font-medium text-gray-900">S/ 0.00</span>
                </div>
                <div class="flex justify-between items-center text-lg font-bold text-gray-900 border-t border-gray-200 pt-3 mb-4">
                  <span>Total</span><span id="r-total" class="text-emerald-600">S/ 0.00</span>
                </div>

                <div class="mb-5">
                  <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Método de pago</label>
                  <select id="pago-metodo" onchange="calcVuelto()" class="w-full px-4 py-2.5 rounded-lg border border-gray-200 bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none transition-all text-sm font-medium text-gray-700">
                    <option>Efectivo</option>
                    <option>Tarjeta</option>
                    <option>Yape</option>
                    <option>Transferencia</option>
                  </select>
                </div>

                <button onclick="confirmarVenta()" class="w-full py-3.5 rounded-xl bg-emerald-600 text-white font-bold shadow-lg shadow-emerald-600/20 hover:bg-emerald-500 hover:-translate-y-0.5 transition-all">
                  Confirmar Venta
                </button>
              </div>

            </div>

          </div>
        </div>

      </div>

      <!-- HISTORIAL PANEL -->
      <div id="panel-historial" class="hidden">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Total Ventas</p>
            <h3 class="text-3xl font-bold text-gray-900"><%= stats.total_ventas %></h3>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Ingresos</p>
            <h3 class="text-3xl font-bold text-emerald-600">S/ <%= parseFloat(stats.ingresos_totales).toFixed(2) %></h3>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Ticket Promedio</p>
            <h3 class="text-3xl font-bold text-indigo-600">S/ <%= parseFloat(stats.ticket_promedio).toFixed(2) %></h3>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="p-6 border-b border-gray-100 bg-gray-50/50">
            <h3 class="text-lg font-bold text-gray-900">Registro de Ventas</h3>
          </div>
          <div class="overflow-x-auto">
            <% if (!ventas.length) { %>
              <div class="text-center py-10 text-gray-400 font-medium">Aún no hay ventas registradas.</div>
            <% } else { %>
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-white text-xs uppercase tracking-wider text-gray-500 font-semibold border-b border-gray-100">
                    <th class="px-6 py-4">ID</th>
                    <th class="px-6 py-4">Cliente</th>
                    <th class="px-6 py-4">Fecha</th>
                    <th class="px-6 py-4">Estado</th>
                    <th class="px-6 py-4 text-right">Total</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                  <% ventas.forEach(v => { %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 font-mono text-gray-500">#<%= v.id %></td>
                    <td class="px-6 py-4">
                      <p class="font-medium text-gray-900"><%= v.cliente %></p>
                      <% if (v.notas) { %><p class="text-xs text-gray-500 mt-0.5 italic"><%= v.notas %></p><% } %>
                    </td>
                    <td class="px-6 py-4 text-gray-600">
                      <%= v.fecha_venta %>
                      <% if (es_admin) { %><br><span class="text-xs font-medium text-indigo-600">por <%= v.trabajador %></span><% } %>
                    </td>
                    <td class="px-6 py-4">
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">OK</span>
                    </td>
                    <td class="px-6 py-4 font-bold text-gray-900 text-right">S/ <%= parseFloat(v.total).toFixed(2) %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
          </div>
        </div>

      </div>

    </main>
  </div>

  <style>
    /* Add specific scrollbar for inner containers */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }
    
    @keyframes slideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  </style>

  <script type="application/json" id="ventas-productos"><%- JSON.stringify(productos) %></script>

  <script>
    const PRODUCTOS = JSON.parse(document.getElementById('ventas-productos').textContent || '[]');
    let stockActual = {};
    PRODUCTOS.forEach(p => stockActual[p.id] = p.cantidad);
    let carrito = {};
    let catActiva = 'Todas';
    const categorias = ['Todas', ...new Set(PRODUCTOS.map(p => p.categoria))];

    function cambiarTab(tab) {
      const isNueva = tab === 'nueva';
      const isHistorial = tab === 'historial';
      
      const pNueva = document.getElementById('panel-nueva');
      const pHistorial = document.getElementById('panel-historial');
      const tNueva = document.getElementById('tab-nueva');
      const tHistorial = document.getElementById('tab-historial');

      if(isNueva) {
        pNueva.classList.remove('hidden'); pNueva.classList.add('block');
        pHistorial.classList.remove('block'); pHistorial.classList.add('hidden');
        tNueva.className = "px-6 py-3 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 transition-colors";
        tHistorial.className = "px-6 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors";
      } else {
        pHistorial.classList.remove('hidden'); pHistorial.classList.add('block');
        pNueva.classList.remove('block'); pNueva.classList.add('hidden');
        tHistorial.className = "px-6 py-3 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 transition-colors";
        tNueva.className = "px-6 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors";
      }
    }

    function renderPills() {
      document.getElementById('cat-pills').innerHTML = categorias.map(c => {
        const onClass = c === catActiva 
          ? "bg-emerald-100 text-emerald-800 border-emerald-200" 
          : "bg-white text-gray-500 border-gray-200 hover:bg-gray-50";
        return `<button class="px-4 py-1.5 rounded-full text-xs font-semibold border transition-colors ${onClass}" onclick="setCat('${c}')">${c}</button>`;
      }).join('');
    }
    function setCat(c) { catActiva = c; renderPills(); renderGrid(); }

    function renderGrid() {
      const q = document.getElementById('buscar').value.toLowerCase();
      const lista = PRODUCTOS.filter(p => {
        const mc = catActiva === 'Todas' || p.categoria === catActiva;
        const mq = !q || p.nombre_producto.toLowerCase().includes(q)
                      || p.marca.toLowerCase().includes(q)
                      || p.categoria.toLowerCase().includes(q);
        return mc && mq;
      });
      const g = document.getElementById('pgrid');
      if (!lista.length) { 
        g.innerHTML = '<div class="col-span-full py-10 text-center text-gray-400 font-medium">Sin resultados</div>'; 
        return; 
      }
      g.innerHTML = lista.map(p => {
        const st = stockActual[p.id];
        const sc = st === 0 ? 'bg-red-100 text-red-700' : st <= 4 ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700';
        const sl = st === 0 ? 'Sin stock' : `${st} uds`;
        const enCart = carrito[p.id] ? `<span class="absolute bottom-3 right-3 text-[10px] font-bold text-white bg-emerald-500 px-2 py-0.5 rounded-full">×${carrito[p.id].qty}</span>` : '';
        const selClass = carrito[p.id] ? 'border-emerald-400 bg-emerald-50/30 ring-1 ring-emerald-400' : 'border-gray-200 bg-white hover:border-emerald-300 hover:shadow-md';
        const opacClass = st === 0 ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer';
        
        return `
        <div class="relative rounded-xl border p-4 transition-all ${selClass} ${opacClass}" onclick="${st>0?`addProd(${p.id})`:''}">
          <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-bold tracking-wider uppercase text-gray-400">${p.categoria}</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-md ${sc}">${sl}</span>
          </div>
          <div class="text-sm font-bold text-gray-900 leading-tight mb-1 pr-4">${p.nombre_producto}</div>
          <div class="text-xs text-gray-500 mb-3">${p.marca}</div>
          <div class="text-lg font-bold text-emerald-600">S/ ${parseFloat(p.precio).toFixed(2)}</div>
          ${enCart}
        </div>`;
      }).join('');
    }

    function addProd(id) {
      const p = PRODUCTOS.find(x => x.id === id);
      if (!p || stockActual[id] === 0) return;
      if (carrito[id]) {
        if (carrito[id].qty >= stockActual[id]) { alerta('Stock insuficiente'); return; }
        carrito[id].qty++;
      } else {
        carrito[id] = { ...p, qty: 1 };
      }
      render();
    }

    function cambiarQty(id, delta) {
      if (!carrito[id]) return;
      const nq = carrito[id].qty + delta;
      if (nq <= 0) { delete carrito[id]; }
      else if (nq > stockActual[id]) { alerta(`Máximo: ${stockActual[id]} uds`); return; }
      else { carrito[id].qty = nq; }
      render();
    }

    function setQty(id, val) {
      const nq = parseInt(val) || 1;
      if (!carrito[id]) return;
      if (nq <= 0) { delete carrito[id]; }
      else if (nq > stockActual[id]) { carrito[id].qty = stockActual[id]; alerta(`Máximo: ${stockActual[id]} uds`); }
      else { carrito[id].qty = nq; }
      render();
    }

    function delProd(id) { delete carrito[id]; render(); }
    function vaciarCarrito() { carrito = {}; render(); }

    function alerta(msg) {
      Swal.fire({ icon:'warning', title:'Atención', text:msg, 
        background: document.body.classList.contains('dark') ? '#1e293b' : '',
        color: document.body.classList.contains('dark') ? '#f1f5f9' : '',
        confirmButtonColor:'#059669', confirmButtonText:'Entendido' });
    }

    function render() {
      const items = Object.values(carrito);
      document.getElementById('badge-carrito').textContent = items.reduce((s,i)=>s+i.qty,0);
      const body  = document.getElementById('cart-body');
      const empty = document.getElementById('cart-empty');
      const res   = document.getElementById('resumen');
      if (!items.length) { body.innerHTML=''; empty.style.display=''; res.style.display='none'; renderGrid(); return; }
      
      empty.style.display = 'none'; res.style.display = 'block';
      
      body.innerHTML = items.map(it => `
        <div class="flex items-center justify-between p-3 rounded-xl border border-gray-100 bg-white shadow-sm gap-3">
          <div class="flex-1 min-w-0">
            <div class="text-sm font-bold text-gray-900 truncate">${it.nombre_producto}</div>
            <div class="text-xs text-gray-500">S/ ${parseFloat(it.precio).toFixed(2)} c/u</div>
          </div>
          <div class="flex items-center gap-1.5 bg-gray-50 p-1 rounded-lg border border-gray-200">
            <button onclick="cambiarQty(${it.id},-1)" class="w-6 h-6 rounded bg-white border border-gray-200 flex items-center justify-center text-gray-600 hover:bg-gray-100 font-medium">−</button>
            <input type="number" value="${it.qty}" min="1" max="${stockActual[it.id]}" onchange="setQty(${it.id},this.value)" class="w-8 text-center text-xs font-bold bg-transparent outline-none p-0 border-none appearance-none" style="-moz-appearance: textfield;" />
            <button onclick="cambiarQty(${it.id},+1)" class="w-6 h-6 rounded bg-white border border-gray-200 flex items-center justify-center text-gray-600 hover:bg-gray-100 font-medium">+</button>
          </div>
          <div class="text-sm font-bold text-gray-900 w-16 text-right">S/ ${(parseFloat(it.precio)*it.qty).toFixed(2)}</div>
          <button onclick="delProd(${it.id})" class="text-gray-400 hover:text-red-500 transition-colors p-1"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>
        </div>`).join('');
        
      const sub = items.reduce((s,i)=>s+parseFloat(i.precio)*i.qty, 0);
      document.getElementById('r-sub').textContent   = `S/ ${sub.toFixed(2)}`;
      document.getElementById('r-igv').textContent   = `S/ ${(sub*.18).toFixed(2)}`;
      document.getElementById('r-total').textContent = `S/ ${(sub*1.18).toFixed(2)}`;
      renderGrid();
    }

    function calcVuelto() {} // Mantenemos firma para compatibilidad, aunque no se usa en la UI actual

    function confirmarVenta() {
      const cliente = document.getElementById('cli-nombre').value.trim();
      const notas   = document.getElementById('cli-notas').value.trim();
      const metodo_pago = document.getElementById('pago-metodo').value;
      const items   = Object.values(carrito);

      if (!cliente) { alerta('El nombre del cliente es obligatorio.'); return; }
      if (!items.length) { alerta('El carrito está vacío.'); return; }

      const total   = items.reduce((s,i)=>s+parseFloat(i.precio)*i.qty,0)*1.18;
      const resumen = items.map(i=>`<div class="flex justify-between text-sm py-1 border-b border-gray-100"><span class="text-gray-600 truncate mr-4">${i.nombre_producto}</span><span class="font-semibold text-gray-900 shrink-0">×${i.qty}</span></div>`).join('');

      Swal.fire({
        title: '¿Confirmar venta?',
        background: document.body.classList.contains('dark') ? '#1e293b' : '',
        color: document.body.classList.contains('dark') ? '#f1f5f9' : '',
        html: `
          <div class="text-left mt-4 mb-4 max-h-40 overflow-y-auto pr-2 custom-scrollbar">${resumen}</div>
          <div class="flex justify-between items-center bg-emerald-50 p-3 rounded-xl border border-emerald-100">
            <span class="font-bold text-gray-700">Total</span>
            <span class="text-xl font-bold text-emerald-600">S/ ${total.toFixed(2)}</span>
          </div>
        `,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#059669',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Registrar',
        cancelButtonText: 'Cancelar'
      }).then(result => {
        if (!result.isConfirmed) return;

        const detalle = items.map(it => ({
          producto_id: it.id, cantidad: it.qty, precio_unitario: parseFloat(it.precio)
        }));

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/ventas';
        [['cliente',cliente],['notas',notas],['items',JSON.stringify(detalle)],['metodo_pago',metodo_pago]].forEach(([k,v]) => {
          const inp = document.createElement('input');
          inp.type = 'hidden'; inp.name = k; inp.value = v;
          form.appendChild(inp);
        });
        document.body.appendChild(form);

        Swal.fire({
          title: '¡Venta registrada!',
          background: document.body.classList.contains('dark') ? '#1e293b' : '',
          color: document.body.classList.contains('dark') ? '#f1f5f9' : '',
          text: `La venta de ${cliente} fue guardada.`,
          icon: 'success',
          confirmButtonColor: '#059669',
          confirmButtonText: 'Continuar',
          timer: 3000,
          timerProgressBar: true,
        }).then(() => {
          form.submit();
        });
      });
    }

    renderPills(); renderGrid(); render();
  </script>
                <script>
  (function () {
    var btn = document.getElementById('dark-mode-toggle');
    var moon = document.getElementById('icon-moon');
    var sun = document.getElementById('icon-sun');
    function applyDark(isDark) {
      document.body.classList.toggle('dark', isDark);
      moon.classList.toggle('hidden', isDark);
      sun.classList.toggle('hidden', !isDark);
        // Forzar fondo oscuro en los charts de ApexCharts
setTimeout(function() {
  document.querySelectorAll('.apexcharts-canvas').forEach(function(canvas) {
    canvas.style.background = isDark ? '#1e293b' : '';
  });
}, 800);
    }
    applyDark(localStorage.getItem('pa-dark-mode') === '1');
    btn.addEventListener('click', function () {
      var isDark = !document.body.classList.contains('dark');
      localStorage.setItem('pa-dark-mode', isDark ? '1' : '0');
      applyDark(isDark);
    });
  })();
</script>
