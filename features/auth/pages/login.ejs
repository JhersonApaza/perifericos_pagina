<!DOCTYPE html>
<html lang="es" class="auth-page">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Acceso al Sistema | Periféricos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/auth-experience.css">
  <style>
    /* Transición suave para expandir la card */
    .auth-card {
      transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), padding 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .auth-card.facial-mode {
      max-width: 800px !important;
    }
    
    /* Grid de reconocimiento facial responsivo */
    .facial-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      animation: fadeIn 0.4s ease;
    }
    
    @media (min-width: 768px) {
      .facial-grid {
        grid-template-columns: 1.15fr 0.85fr;
        gap: 2.25rem;
        align-items: center;
      }
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="auth-page font-sans selection:bg-indigo-500/30 min-h-screen overflow-x-hidden relative flex flex-col">

  <!-- Blobs difuminados en lugar del canvas de neuronas -->
  <div class="auth-blob auth-blob-1"></div>
  <div class="auth-blob auth-blob-2"></div>
  <div class="auth-blob auth-blob-3"></div>

  <%- include('../../../shared/components/loader', { forceDark: true }) %>

  <% if (toast_warn) { %>
    <div class="auth-toast auth-toast-warn" role="alert">
      <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#f87171;flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      <p><%= toast_warn %></p>
    </div>
  <% } %>
  <% if (toast_ok) { %>
    <div class="auth-toast auth-toast-ok" role="status">
      <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#34d399;flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p><%= toast_ok %></p>
    </div>
  <% } %>

  <!-- Contenedor principal centrado -->
  <div style="position:relative;z-index:10;flex:1;display:flex;align-items:center;justify-content:center;padding:1.5rem 1rem;min-height:100vh;box-sizing:border-box;">

    <!-- ==========================================
         VISTA 1: CREDENCIALES (credentials)
         ========================================== -->
    <div id="loginCredentialsView" class="auth-card auth-anim w-full max-w-md p-10 box-border">
      
      <!-- Header -->
      <div class="auth-header-sep" style="margin-bottom:1.5rem">
        <div class="auth-logo-icon">
          <svg class="w-5 h-5" style="color:white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.071 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/>
          </svg>
        </div>
        <div>
          <span style="display:block;font-size:0.6rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#818cf8">Acceso al Sistema</span>
          <span style="font-size:0.73rem;font-weight:600;color:#475569">Periféricos Auth</span>
        </div>
      </div>

      <!-- Cuerpo -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;margin-top:1.5rem">
        <div>
          <h2 style="margin:0 0 0.5rem;font-size:1.875rem;font-weight:900;color:#f1f5f9;letter-spacing:-0.03em;line-height:1.2">Bienvenido de nuevo</h2>
          <p style="margin:0;font-size:0.8rem;color:#475569;font-weight:500">Ingresa tus credenciales para recibir el código OTP de acceso.</p>
        </div>

        <form method="POST" action="/" style="display:flex;flex-direction:column;gap:1.25rem">
          <div style="display:flex;flex-direction:column;gap:0.5rem">
            <label class="auth-label" style="margin:0">Usuario</label>
            <input type="text" name="usuario" placeholder="juan.perez" required autocomplete="username" class="auth-input">
          </div>
          <div style="display:flex;flex-direction:column;gap:0.5rem">
            <label class="auth-label" style="margin:0">Contraseña</label>
            <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password" class="auth-input">
          </div>
          <button type="submit" class="auth-btn-primary" style="margin-top:0.25rem">
            Ingresar al sistema
          </button>
        </form>

        <div class="auth-divider" style="margin:0.25rem 0">
          <div class="auth-divider-line"></div>
          <span class="auth-divider-text">o accede con</span>
          <div class="auth-divider-line"></div>
        </div>

        <button type="button" id="btnShowFaceLogin" class="auth-btn-secondary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2v11z"/>
            <circle cx="12" cy="13" r="3.5"/>
          </svg>
          Reconocimiento facial
        </button>

        <p style="text-align:center;font-size:0.85rem;color:#475569;font-weight:500;margin:0">
          ¿No tienes cuenta? <a href="/registro" class="auth-link">Regístrate aquí</a>
        </p>
      </div>
    </div>

    <!-- ==========================================
         VISTA 2: BIOMETRÍA FACIAL (facial)
         ========================================== -->
    <div id="loginFacialView" class="auth-card auth-anim w-full max-w-md p-10 box-border" style="display:none;">
      
      <!-- Header -->
      <div class="auth-header-sep" style="margin-bottom:1.5rem">
        <div class="auth-logo-icon">
          <svg class="w-5 h-5" style="color:white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.071 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/>
          </svg>
        </div>
        <div>
          <span style="display:block;font-size:0.6rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#818cf8">Acceso al Sistema</span>
          <span style="font-size:0.73rem;font-weight:600;color:#475569">Periféricos Auth</span>
        </div>
      </div>

      <!-- Cuerpo -->
      <div style="display:flex;flex-direction:column;gap:1.25rem;margin-top:1.5rem">
        <div>
          <span class="auth-badge auth-badge-indigo" style="margin-bottom:0.4rem;display:inline-block">Biometría Activa</span>
          <h2 style="margin:0 0 0.4rem;font-size:1.875rem;font-weight:900;color:#f1f5f9;letter-spacing:-0.03em;line-height:1.2">Acceso por Rostro</h2>
          <p style="margin:0;font-size:0.8rem;color:#475569;font-weight:500;line-height:1.45">Pulsa encender cámara, céntrate en el recuadro y captura tu rostro.</p>
        </div>

        <!-- Visor de cámara compacto -->
        <div class="auth-video-wrap scanner-effect video-wrapper w-full h-52 rounded-xl bg-black flex items-center justify-center overflow-hidden relative">
          <div class="auth-video-placeholder">
            <svg class="w-8 h-8" style="opacity:0.28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <circle cx="12" cy="13" r="3"/>
            </svg>
            <span style="font-size:0.75rem;margin-top:0.4rem;color:rgba(148,163,184,0.4)">Cámara Apagada</span>
          </div>
          <video id="videoLogin" style="position:relative;z-index:10;width:100%;height:100%;object-fit:cover;transition:opacity 0.5s" playsinline muted></video>
          <canvas id="canvasFaceLogin" style="position:absolute;inset:0;z-index:20;width:100%;height:100%" aria-hidden="true"></canvas>
        </div>

        <!-- Botones de Acción -->
        <div class="auth-btn-grid" style="gap:0.75rem">
          <button type="button" id="btnEncenderLogin" class="auth-btn-cam" style="padding:0.75rem 1rem;font-size:0.85rem">
            Encender cámara
          </button>
          <form id="formFaceLogin" method="POST" action="/login_face" style="width:100%">
            <input type="hidden" name="face_descriptor" id="faceDescLogin" value="">
            <button type="button" id="btnFaceLogin" disabled class="auth-btn-capture" style="padding:0.75rem 1rem;font-size:0.85rem;width:100%">
              Capturar y entrar
            </button>
          </form>
        </div>

        <!-- Box de recomendación -->
        <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.05);padding:0.85rem 1rem;border-radius:0.75rem">
          <p style="margin:0;font-size:0.72rem;color:#475569;line-height:1.45">
            <strong style="color:#a5b4fc">Recomendación:</strong> Mantén tu rostro bien iluminado y céntrate en el visor para garantizar una captura óptima.
          </p>
        </div>

        <!-- Volver a credenciales -->
        <button type="button" id="btnHideFaceLogin" class="auth-back-btn" style="align-self:center;font-size:0.85rem;margin:0;background:none;border:none;">
          ← Volver a credenciales
        </button>
      </div>
    </div>

  <script src="/js/vendor/face-api.min.js"></script>
  <script src="/js/auth/face-auth.js"></script>
  <script src="/js/auth/login.js"></script>
</body>
</html>
