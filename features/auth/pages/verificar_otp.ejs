<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verificar OTP | Periféricos</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="h-screen bg-white font-sans text-gray-900 selection:bg-indigo-200 overflow-hidden">
  
  <%- include('../../../shared/components/loader') %>

  <div class="flex h-full w-full">
    <!-- Lado izquierdo (Decorativo) -->
    <div class="hidden lg:flex flex-col justify-between w-5/12 bg-gray-900 p-12 text-white relative overflow-hidden shrink-0">
      <div class="absolute top-[-20%] left-[-10%] w-[140%] h-[140%] bg-gradient-to-br from-indigo-600/40 via-purple-900/40 to-black rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[80%] h-[80%] bg-gradient-to-tl from-purple-600/30 to-transparent rounded-full blur-[80px] pointer-events-none"></div>
      
      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-16">
          <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md flex items-center justify-center font-bold text-xl border border-white/20 shadow-xl">
            <svg class="w-6 h-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.071 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/></svg>
          </div>
          <span class="font-semibold text-xl tracking-tight text-white/90">Periféricos Auth</span>
        </div>
        
        <h1 class="text-5xl font-bold leading-[1.1] tracking-tight mb-6">
          Seguridad en <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">2 Pasos</span>
        </h1>
        <p class="text-indigo-100/70 text-lg max-w-md leading-relaxed font-light">
          Hemos enviado un código seguro a tu correo electrónico. Ingresa los 6 dígitos para completar el acceso.
        </p>
      </div>
    </div>

    <!-- Lado derecho (Formulario) -->
    <div class="w-full lg:w-7/12 flex-1 overflow-y-auto bg-white">
      <div class="min-h-full flex items-center justify-center p-6 sm:p-12 relative">
        
        <!-- Alertas -->
        <% if (toast_warn) { %>
          <div class="absolute top-6 right-6 lg:right-12 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl shadow-sm z-50 flex items-start gap-3 animate-[slideInRight_0.3s_ease-out]" role="alert">
            <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <p class="text-sm font-medium"><%= toast_warn %></p>
          </div>
        <% } %>

        <div class="w-full max-w-sm xl:max-w-md relative">
          
          <% if (toast_ok) { %>
            <div class="mb-8 bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-4 rounded-2xl shadow-sm flex items-start gap-3" role="status">
              <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <p class="text-sm font-medium pt-1"><%= toast_ok %></p>
            </div>
          <% } %>

          <div class="text-center lg:text-left mb-8">
            <p class="text-xs font-bold text-purple-600 tracking-widest uppercase mb-1">Paso Final</p>
            <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Verificación OTP</h2>
            <p class="mt-2 text-sm text-gray-500">Revisa tu bandeja de entrada o spam para encontrar el código.</p>
          </div>

          <form method="POST" action="/verificar" class="space-y-6">
            <div class="space-y-2">
              <label class="block text-sm font-medium text-gray-700 text-center lg:text-left">Código de 6 dígitos</label>
              <input type="text" name="otp" maxlength="6" placeholder="000000" required inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" 
                class="w-full px-6 py-4 rounded-2xl border border-gray-200 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all text-gray-900 placeholder-gray-300 outline-none text-center text-4xl tracking-[0.5em] font-bold">
            </div>
            
            <button type="submit" class="w-full py-4 px-4 rounded-xl bg-purple-600 text-white font-semibold shadow-lg shadow-purple-600/20 hover:bg-purple-500 hover-lift transition-all">
              Verificar e Ingresar
            </button>
          </form>

          <p class="text-center text-sm text-gray-500 mt-8">
            <a href="/" class="font-medium text-gray-600 hover:text-gray-900 hover:underline underline-offset-4 transition-colors flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              Volver al inicio
            </a>
          </p>

        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes slideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  </style>
</body>
</html>
