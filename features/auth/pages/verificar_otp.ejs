<!DOCTYPE html>
<html lang="es" class="auth-page">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verificar OTP | Periféricos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/auth-experience.css">
</head>
<body class="auth-page font-sans selection:bg-purple-500/30 min-h-screen overflow-x-hidden relative flex">

  <!-- Blobs difuminados -->
  <div class="auth-blob auth-blob-1" style="background:radial-gradient(circle,rgba(139,92,246,0.22) 0%,transparent 65%)"></div>
  <div class="auth-blob auth-blob-2" style="background:radial-gradient(circle,rgba(99,102,241,0.18) 0%,transparent 65%)"></div>
  <div class="auth-blob auth-blob-3" style="background:radial-gradient(circle,rgba(236,72,153,0.08) 0%,transparent 70%)"></div>

  <%- include('../../../shared/components/loader', { forceDark: true }) %>

  <% if (toast_warn) { %>
    <div class="auth-toast auth-toast-warn" role="alert">
      <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#f87171;flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      <p><%= toast_warn %></p>
    </div>
  <% } %>

  <!-- Layout flex: panel decorativo + formulario -->
  <div style="position:relative;z-index:10;display:flex;width:100%;min-height:100vh">

    <!-- ── Panel decorativo izquierdo (solo desktop) ── -->
    <div class="auth-otp-deco">
      <div style="position:relative;z-index:1">
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:4rem">
          <div class="auth-logo-icon" style="background:linear-gradient(135deg,#7c3aed,#a78bfa);box-shadow:0 8px 20px rgba(124,58,237,0.38)">
            <svg class="w-5 h-5" style="color:white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.071 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/>
            </svg>
          </div>
          <span style="font-size:1.1rem;font-weight:700;color:rgba(255,255,255,0.85);letter-spacing:-0.02em">Periféricos Auth</span>
        </div>

        <h1 style="margin:0 0 1.25rem;font-size:clamp(2rem,3.5vw,3rem);font-weight:900;color:#f1f5f9;letter-spacing:-0.04em;line-height:1.05">
          Seguridad en<br>
          <span style="background:linear-gradient(135deg,#a78bfa,#ec4899);-webkit-background-clip:text;background-clip:text;color:transparent">2 Pasos</span>
        </h1>

        <p style="margin:0;font-size:1rem;color:rgba(148,163,184,0.8);line-height:1.6;max-width:28ch;font-weight:400">
          Hemos enviado un código seguro a tu correo electrónico. Ingresa los 6 dígitos para completar el acceso.
        </p>
      </div>

      <div style="position:relative;z-index:1">
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:1rem;padding:1.25rem;display:flex;flex-direction:column;gap:0.75rem">
          <div style="display:flex;align-items:center;gap:0.75rem">
            <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(99,102,241,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg style="width:1rem;height:1rem;color:#818cf8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div>
              <p style="margin:0;font-size:0.72rem;font-weight:700;color:#f1f5f9">Verificación de 2 factores</p>
              <p style="margin:0;font-size:0.65rem;color:#475569">Código enviado a tu correo</p>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:0.75rem">
            <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(16,185,129,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg style="width:1rem;height:1rem;color:#34d399" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <div>
              <p style="margin:0;font-size:0.72rem;font-weight:700;color:#f1f5f9">Cifrado extremo a extremo</p>
              <p style="margin:0;font-size:0.65rem;color:#475569">Tu sesión es completamente segura</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Panel derecho: Formulario ── -->
    <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:2rem 1.25rem;min-height:100vh">
      <div style="width:100%;max-width:420px">

        <% if (toast_ok) { %>
          <div style="margin-bottom:1.75rem;background:rgba(6,78,59,0.85);border:1px solid rgba(16,185,129,0.25);color:#a7f3d0;padding:1rem 1.25rem;border-radius:1rem;display:flex;align-items:flex-start;gap:0.75rem;backdrop-filter:blur(12px)" role="status">
            <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(16,185,129,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg style="width:1.1rem;height:1.1rem;color:#34d399" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <p style="margin:0;font-size:0.875rem;font-weight:500;padding-top:0.2rem"><%= toast_ok %></p>
          </div>
        <% } %>

        <div class="auth-anim">
          <p style="margin:0 0 0.3rem;font-size:0.6rem;font-weight:800;color:#a78bfa;letter-spacing:0.1em;text-transform:uppercase">Paso Final</p>
          <h2 style="margin:0 0 0.4rem;font-size:1.85rem;font-weight:900;color:#f1f5f9;letter-spacing:-0.035em">Verificación OTP</h2>
          <p style="margin:0 0 2rem;font-size:0.875rem;color:#475569">Revisa tu bandeja de entrada o spam para encontrar el código.</p>

          <form method="POST" action="/verificar" style="display:flex;flex-direction:column;gap:1.25rem">
            <div>
              <label style="display:block;text-align:center;margin-bottom:0.75rem;font-size:0.78rem;font-weight:600;color:#64748b">Código de 6 dígitos</label>
              <input
                type="text"
                name="otp"
                maxlength="6"
                placeholder="000000"
                required
                inputmode="numeric"
                pattern="[0-9]{6}"
                autocomplete="one-time-code"
                class="auth-otp-input"
              >
            </div>

            <button type="submit" class="auth-btn-purple">
              Verificar e Ingresar
            </button>
          </form>

          <p style="text-align:center;margin-top:1.75rem">
            <a href="/" style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.875rem;font-weight:600;color:#475569;text-decoration:none;transition:color 0.2s" onmouseover="this.style.color='#94a3b8'" onmouseout="this.style.color='#475569'">
              <svg style="width:1rem;height:1rem" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              Volver al inicio
            </a>
          </p>
        </div>
      </div>
    </div>

  </div>
</body>
</html>
