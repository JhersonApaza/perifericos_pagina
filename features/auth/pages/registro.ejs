<!DOCTYPE html>
<html lang="es" class="auth-page">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registro | Periféricos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/auth-experience.css">
  <style>
    /* Medidor de contraseña — dark mode override */
    .pwd-meter-fill      { background: rgba(255,255,255,0.07); }
    .pwd-meter-fill.n0   { width: 12%;  background: #ef4444; }
    .pwd-meter-fill.n1   { width: 25%;  background: #f43f5e; }
    .pwd-meter-fill.n2   { width: 50%;  background: #f59e0b; }
    .pwd-meter-fill.n3   { width: 75%;  background: #6366f1; }
    .pwd-meter-fill.n4   { width: 100%; background: #10b981; }
    /* Grilla de registro responsiva */
    .reg-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    @media (max-width: 767px) {
      .reg-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    }
  </style>
</head>
<body class="auth-page font-sans selection:bg-indigo-500/30 min-h-screen overflow-x-hidden relative flex flex-col">

  <!-- Blobs difuminados -->
  <div class="auth-blob auth-blob-1"></div>
  <div class="auth-blob auth-blob-2" style="background:radial-gradient(circle,rgba(16,185,129,0.14) 0%,transparent 65%)"></div>
  <div class="auth-blob auth-blob-3" style="background:radial-gradient(circle,rgba(139,92,246,0.10) 0%,transparent 70%)"></div>

  <%- include('../../../shared/components/loader', { forceDark: true }) %>

  <% if (toast_warn) { %>
    <div class="auth-toast auth-toast-warn" role="alert">
      <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#f87171;flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      <p><%= toast_warn %></p>
    </div>
  <% } %>

  <!-- Contenedor principal -->
  <div style="position:relative;z-index:10;flex:1;display:flex;align-items:center;justify-content:center;padding:1.5rem 1rem;min-height:100vh">

    <!-- Card ancha para dos columnas -->
    <div class="auth-card auth-anim w-full max-w-5xl p-10 my-6 box-border">

      <!-- Header -->
      <div class="auth-header-sep" style="justify-content:space-between;flex-wrap:wrap;gap:0.75rem;margin-bottom:1.5rem">
        <div style="display:flex;align-items:center;gap:0.75rem">
          <div class="auth-logo-icon" style="background:linear-gradient(135deg,#059669,#10b981);box-shadow:0 8px 20px rgba(5,150,105,0.38)">
            <svg class="w-5 h-5" style="color:white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.071 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/>
            </svg>
          </div>
          <div>
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.2rem">
               <span class="auth-badge auth-badge-emerald">Registro Biométrico</span>
              <span style="font-size:0.72rem;font-weight:600;color:#475569">Periféricos Auth</span>
            </div>
            <h2 style="margin:0;font-size:1.875rem;font-weight:900;color:#f1f5f9;letter-spacing:-0.03em;line-height:1.2">Crear cuenta nueva</h2>
          </div>
        </div>
        <span style="font-size:0.7rem;font-weight:600;color:#475569;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.09);padding:0.35rem 0.75rem;border-radius:0.5rem">
          Los datos biométricos se comparan localmente
        </span>
      </div>

      <!-- Grid 2 columnas: cámara | formulario -->
      <div class="reg-grid" style="gap:2.5rem">

        <!-- ── Columna izquierda: Biometría ── -->
        <div style="background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.07);border-radius:1.25rem;padding:2rem;display:flex;flex-direction:column;gap:1.5rem">
          <div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem">
              <span class="auth-section-label">1. Capturar Rostro</span>
              <span style="font-size:0.6rem;font-weight:800;color:#818cf8;background:rgba(99,102,241,0.14);border:1px solid rgba(99,102,241,0.25);padding:0.2rem 0.55rem;border-radius:999px;letter-spacing:0.06em;text-transform:uppercase">Paso Obligatorio</span>
            </div>
            <p style="margin:0;font-size:0.76rem;color:#475569;line-height:1.55">Enciende tu cámara, alinea tu rostro y presiona capturar.</p>
          </div>

          <!-- Video — IMPORTANTE: mantener IDs para face-api -->
          <div class="auth-video-wrap scanner-effect video-wrapper w-full h-64 rounded-xl bg-black flex items-center justify-center overflow-hidden relative">
            <div class="auth-video-placeholder">
              <svg class="w-10 h-10" style="opacity:0.25" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <circle cx="12" cy="13" r="3"/>
              </svg>
              <span style="font-size:0.75rem;margin-top:0.4rem;color:rgba(148,163,184,0.4)">Cámara Apagada</span>
            </div>
            <video id="videoRegistro" style="position:relative;z-index:10;width:100%;height:100%;object-fit:cover;transition:opacity 0.5s" playsinline muted></video>
            <canvas id="canvasFaceRegistro" style="position:absolute;inset:0;z-index:20;width:100%;height:100%" aria-hidden="true"></canvas>
          </div>

          <div class="auth-btn-grid" style="gap:0.75rem">
            <button type="button" id="btnEncenderReg" class="auth-btn-cam" style="padding:0.75rem 1rem;font-size:0.85rem">Encender cámara</button>
            <button type="button" id="btnCapturarReg" class="auth-btn-capture" style="padding:0.75rem 1rem;font-size:0.85rem">Capturar rostro</button>
          </div>
        </div>

        <!-- ── Columna derecha: Formulario ── -->
        <div style="display:flex;flex-direction:column;justify-content:center">
          <form id="formRegistro" method="POST" action="/registro" style="display:flex;flex-direction:column;gap:1.25rem">
            <!-- Input oculto descriptor — mantener ID -->
            <input type="hidden" name="face_descriptor" id="faceDescReg" value="">

            <span class="auth-section-label" style="margin-bottom:0.25rem">2. Datos de Cuenta</span>

            <div style="display:flex;flex-direction:column;gap:0.5rem">
              <label class="auth-label" style="margin:0">Usuario</label>
              <input type="text" name="usuario" placeholder="Ej: juan.perez" required autocomplete="username" class="auth-input">
            </div>

            <div style="display:flex;flex-direction:column;gap:0.5rem">
              <label class="auth-label" style="margin:0">Correo Electrónico</label>
              <input type="email" name="correo" placeholder="juan@empresa.com" required autocomplete="email" class="auth-input">
            </div>

            <div style="display:flex;flex-direction:column;gap:0.5rem">
              <label class="auth-label" style="margin:0">Contraseña</label>
              <input type="password" name="password" id="regPassword" placeholder="••••••••" required autocomplete="new-password" minlength="8" class="auth-input">
              <!-- Medidor de fuerza — mantener IDs -->
              <div style="margin-top:0.25rem">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.25rem">
                  <span style="font-size:0.65rem;color:#475569">Seguridad: <span id="pwdMeterText" style="font-weight:700;color:#94a3b8">—</span></span>
                </div>
                <div class="auth-pwd-meter-track">
                  <div id="pwdMeterFill" class="pwd-meter-fill" style="height:100%;border-radius:999px;transition:width 0.3s,background 0.3s"></div>
                </div>
              </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:0.5rem">
              <label class="auth-label" style="margin:0">Confirmar Contraseña</label>
              <input type="password" name="confirm_password" placeholder="••••••••" required autocomplete="new-password" class="auth-input">
            </div>

            <button type="submit" class="auth-btn-emerald" style="margin-top:0.75rem;padding:0.875rem 1rem;font-size:0.9rem">
              Registrar cuenta
            </button>
          </form>

          <p style="text-align:center;font-size:0.85rem;color:#475569;font-weight:500;margin-top:1.5rem">
            ¿Ya tienes cuenta? <a href="/" class="auth-link">Inicia sesión</a>
          </p>
        </div>

      </div>
    </div>
  </div>

  <script src="/js/vendor/face-api.min.js"></script>
  <script src="/js/auth/face-auth.js"></script>
  <script src="/js/auth/registro.js"></script>
</body>
</html>
