  <!-- Heatmap (Vanilla JS) re-integrado -->
  <script>
    (function () {
      var raw = [];
      try { raw = JSON.parse(document.getElementById('heatmap-data').textContent || '[]'); } catch(e){}
      var container = document.getElementById('heatmap-container');
      var emptyMsg  = document.getElementById('heatmap-empty');
      if (!raw.length) {
        if(container) container.style.display = 'none';
        if(emptyMsg) emptyMsg.style.display  = 'block';
        return;
      }
      var dias = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
      var mapa = {}; var maxVal = 0;
      raw.forEach(function(r) {
        var d = parseInt(r.dia_semana), h = parseInt(r.hora), v = parseInt(r.total_ventas);
        if (!mapa[d]) mapa[d] = {};
        mapa[d][h] = (mapa[d][h] || 0) + v;
        if (mapa[d][h] > maxVal) maxVal = mapa[d][h];
      });
      if(!container) return;
      var hd = document.createElement('div');
      hd.className = 'text-[10px] text-gray-400 flex items-center font-medium';
      hd.textContent = 'Hora→';
      container.appendChild(hd);
      for (var h = 0; h < 24; h++) {
        var ch = document.createElement('div');
        ch.className = 'text-[9px] text-center text-gray-400 font-medium';
        ch.textContent = h;
        container.appendChild(ch);
      }
      for (var d = 1; d <= 7; d++) {
        var lbl = document.createElement('div');
        lbl.className = 'text-[11px] font-semibold text-gray-700 flex items-center';
        lbl.textContent = dias[d-1];
        container.appendChild(lbl);
        for (var h2 = 0; h2 < 24; h2++) {
          var val = (mapa[d] && mapa[d][h2]) ? mapa[d][h2] : 0;
          var intens = maxVal > 0 ? val / maxVal : 0;
          var cel = document.createElement('div');
          cel.className = 'h-5 rounded-[3px] transition-colors hover:ring-2 hover:ring-indigo-300';
          cel.style.backgroundColor = 'rgba(79, 70, 229, ' + (intens * 0.85 + (intens > 0 ? 0.15 : 0.05)).toFixed(2) + ')';
          cel.title = dias[d-1] + ' ' + h2 + ':00 — ' + val + ' venta(s)';
          container.appendChild(cel);
        }
      }
      var legend = document.getElementById('heatmap-legend');
      if (legend) {
        for (var i = 0; i <= 5; i++) {
          var s = document.createElement('span');
          var a = i === 0 ? 0.05 : (i / 5 * 0.85 + 0.15).toFixed(2);
          s.className = 'inline-block w-4 h-2.5 rounded-[2px]';
          s.style.backgroundColor = 'rgba(79, 70, 229, ' + a + ')';
          legend.appendChild(s);
        }
      }
    })();
  </script>
                <script>
  (function () {
    var btn = document.getElementById('dark-mode-toggle');
    var moon = document.getElementById('icon-moon');
    var sun = document.getElementById('icon-sun');
    function applyDark(isDark) {
      document.body.classList.toggle('dark', isDark);
      document.documentElement.classList.toggle('dark', isDark);
      moon.classList.toggle('hidden', isDark);
      sun.classList.toggle('hidden', !isDark);
      
      // Sincronizar todos los gráficos de ApexCharts
      if (window.chartInstances && window.chartInstances.length > 0) {
        window.chartInstances.forEach(function(chart) {
          try {
            chart.updateOptions({
              theme: { mode: isDark ? 'dark' : 'light' },
              tooltip: { theme: isDark ? 'dark' : 'light' },
              grid: {
                borderColor: isDark ? '#334155' : '#f1f5f9'
              }
            });
          } catch(e) {}
        });
      }
    }
    applyDark(localStorage.getItem('pa-dark-mode') === '1');
    btn.addEventListener('click', function () {
      var isDark = !document.body.classList.contains('dark');
      localStorage.setItem('pa-dark-mode', isDark ? '1' : '0');
      applyDark(isDark);
    });

    // Controlador del sidebar móvil
    var toggleBtn = document.getElementById('mobile-sidebar-toggle');
    var closeBtn = document.getElementById('mobile-sidebar-close');
    var sidebar = document.getElementById('sidebar-menu');
    var backdrop = document.getElementById('sidebar-backdrop');
    function toggleSidebar(open) {
      if (sidebar) sidebar.classList.toggle('-translate-x-full', !open);
      if (backdrop) backdrop.classList.toggle('hidden', !open);
    }
    if (toggleBtn) toggleBtn.addEventListener('click', function() { toggleSidebar(true); });
    if (closeBtn) closeBtn.addEventListener('click', function() { toggleSidebar(false); });
    if (backdrop) backdrop.addEventListener('click', function() { toggleSidebar(false); });
  })();
</script>
</body>
</html>
