<%
  const statTotal = usuarios.length;
  let statOtp = 0, statRostro = 0;
  for (const u of usuarios) {
    if (u.otp_activo) statOtp++;
    if (u.tiene_rostro) statRostro++;
  }
  const totalVentas = statsVentas ? parseInt(statsVentas.total_ventas) : 0;
  const totalMonto = statsVentas ? parseFloat(statsVentas.total_monto).toFixed(2) : '0.00';
  const bootstrapData = JSON.stringify({ toastOk: toast_ok, toastWarn: toast_warn, labelsDia, dataDia });
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard Analítico | Periféricos</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/custom.css">
  <script src="/vendor/apexcharts/apexcharts.min.js"></script>
  <script>
    (function() {
      var isDark = localStorage.getItem('pa-dark-mode') === '1';
      document.documentElement.classList.toggle('dark', isDark);
      document.addEventListener('DOMContentLoaded', function() {
        document.body.classList.toggle('dark', isDark);
      });
    })();
  </script>
</head>
<body class="bg-slate-50 dark:bg-slate-950 font-sans text-gray-900 overflow-hidden flex h-screen selection:bg-indigo-200 transition-colors duration-300">
  
  <%- include('../../../shared/components/loader') %>
  <div id="toast-container" class="fixed top-6 right-6 z-50 flex flex-col gap-3"></div>

  <!-- Backdrop para el sidebar móvil -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity duration-300"></div>

  <!-- Sidebar -->
  <aside id="sidebar-menu" class="fixed inset-y-0 left-0 z-50 w-64 bg-gray-900 text-white flex flex-col transform -translate-x-full lg:translate-x-0 lg:relative lg:flex transition-transform duration-300 ease-in-out shadow-2xl">
    <div class="h-20 flex items-center justify-between px-8 border-b border-gray-800 relative">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center font-bold text-xl shadow-lg shadow-indigo-500/20">PA</div>
        <span class="font-bold text-lg tracking-tight">Periféricos</span>
      </div>
      <!-- Botón cerrar para móvil -->
      <button id="mobile-sidebar-close" class="lg:hidden p-2 rounded-lg text-gray-400 hover:text-white hover:bg-gray-800 transition-all outline-none" title="Cerrar menú">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <div class="flex-1 overflow-y-auto py-8 px-4">
      <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Menú Principal</p>
      <nav class="space-y-2">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-600 text-white shadow-md shadow-indigo-600/20 transition-all font-medium">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          Dashboard
        </a>
        <a href="/ventas" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-gray-800 hover:text-white transition-all font-medium group">
          <svg class="w-5 h-5 group-hover:text-emerald-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          Punto de Venta
        </a>
      </nav>
      
      <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-widest mt-10 mb-4">Cuenta</p>
      <nav class="space-y-2">
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-red-500/10 hover:text-red-400 transition-all font-medium group">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Cerrar Sesión
        </a>
      </nav>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
    
    <!-- Topbar -->
    <header class="h-20 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-gray-200 dark:border-slate-800 flex items-center justify-between px-4 sm:px-8 sticky top-0 z-10">
      <div class="flex items-center gap-3">
        <button id="mobile-sidebar-toggle" title="Abrir menú"
          class="lg:hidden p-2.5 rounded-xl border border-gray-200 bg-white/70 hover:bg-gray-100 text-gray-600 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:bg-slate-800 dark:text-slate-300 flex items-center justify-center transition-all shadow-sm">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div>
          <h1 class="text-lg sm:text-2xl font-bold text-gray-900 tracking-tight">Bienvenido, <%= nombreUsuario %></h1>
          <p class="text-xs sm:text-sm text-gray-500 font-medium mt-0.5">Ventas · Usuarios · Seguridad</p>
        </div>
      </div>
<div class="flex items-center gap-3">

  <!-- Botón modo oscuro -->
  <button id="dark-mode-toggle" title="Modo oscuro"
    class="w-10 h-10 rounded-xl border border-gray-200 bg-white/70 hover:bg-gray-100 text-gray-600 flex items-center justify-center transition-all shadow-sm hover:-translate-y-0.5">
    <svg id="icon-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
    </svg>
    <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12H3m15.07-6.07-.71.71M6.64 17.36l-.71.71M17.36 17.36l.71.71M6.64 6.64l.71.71M12 7a5 5 0 100 10A5 5 0 0012 7z"/>
    </svg>
  </button>

  <!-- Botón Nueva Venta (sin cambios) -->
  <a href="/ventas" class="px-5 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-xl shadow-md shadow-emerald-600/20 hover:bg-emerald-500 hover:-translate-y-0.5 transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Registrar Venta
  </a>

</div>
    </header>

    <!-- Content Area -->
    <main class="flex-1 overflow-y-auto p-4 sm:p-8 bg-gray-50/50 dark:bg-slate-950">
      
      <!-- KPIs -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
        <!-- KPI 1 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500"><%= es_admin ? 'Trabajadores' : 'Cuenta' %></p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= es_admin ? statTotal : 1 %></h3>
          </div>
        </div>
        
        <!-- KPI 2 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-amber-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500">Total Ventas</p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= totalVentas %></h3>
          </div>
        </div>

        <!-- KPI 3 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500">Monto Total (S/.)</p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= totalMonto %></h3>
          </div>
        </div>

        <!-- KPI 4 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-purple-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500">Enrolamiento Facial</p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= statRostro %></h3>
          </div>
        </div>
      </div>

      <!-- Main Charts -->
      <div class="mb-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col w-full">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Ventas por Día</h3>
              <p class="text-sm text-gray-500">Monto total (S/.) — últimos 30 días</p>
            </div>
            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full border border-indigo-100">Tendencia</span>
          </div>
          <div id="chartDias" style="width:100%;height:300px;min-height:300px;display:block"></div>
          <p id="emptyDias" class="text-center text-gray-400 py-10 hidden">No hay ventas registradas en este periodo.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-6">
        
        <!-- Pareto -->
        <div class="xl:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-4 gap-4">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Curva ABC — Ingresos</h3>
              <p class="text-sm text-gray-500">Últimos 90 días</p>
            </div>
            <div class="flex items-center gap-3 text-xs font-medium text-gray-600">
              <span class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-sm bg-emerald-500"></div>A (0-80%)</span>
              <span class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-sm bg-amber-500"></div>B (80-95%)</span>
              <span class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-sm bg-red-500"></div>C (95-100%)</span>
            </div>
          </div>
          <% if (pareto && pareto.length > 0) { %>
            <div id="chartPareto" style="width:100%;height:320px;min-height:320px;display:block"></div>
          <% } else { %>
            <p class="text-center text-gray-400 py-16">Sin datos de ventas aún.</p>
          <% } %>
        </div>

        <!-- Ranking -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Ranking</h3>
              <p class="text-sm text-gray-500">Trabajadores (30d)</p>
            </div>
          </div>
          <% if (ranking && ranking.length > 0) { %>
            <div id="chartRanking" style="width:100%;height:300px;min-height:300px;display:block"></div>
          <% } else { %>
            <p class="text-center text-gray-400 py-16">Sin datos de ventas aún.</p>
          <% } %>
        </div>
      </div>

      <!-- Heatmap & Stock -->
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-6">
        
        <!-- Heatmap (Vanilla JS) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="mb-4">
            <h3 class="text-lg font-bold text-gray-900">Concentración de Ventas</h3>
            <p class="text-sm text-gray-500">Heatmap por hora y día — últimos 60 días</p>
          </div>
          <div class="overflow-x-auto pb-2">
            <div id="heatmap-container" class="grid gap-[3px] min-w-[680px]" style="grid-template-columns: 44px repeat(24, 1fr);"></div>
            <div class="flex justify-end items-center gap-2 mt-3 text-xs text-gray-500 font-medium">
              <span>Menos</span>
              <div id="heatmap-legend" class="flex gap-0.5"></div>
              <span>Más</span>
            </div>
            <p id="heatmap-empty" class="text-center text-gray-400 py-10 hidden">Sin datos suficientes aún.</p>
          </div>
        </div>

        <!-- Stock -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="mb-4">
            <h3 class="text-lg font-bold text-gray-900">Stock Crítico</h3>
            <p class="text-sm text-gray-500">Productos con pocos días de inventario</p>
          </div>
          <% if (stockAlertas && stockAlertas.length > 0) { %>
            <div id="chartStock" class="w-full min-h-[220px]"></div>
          <% } else { %>
            <div class="flex flex-col items-center justify-center py-10 text-emerald-500">
              <svg class="w-12 h-12 mb-3 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <p class="font-medium">Sin productos en stock crítico. ¡Todo bien!</p>
            </div>
          <% } %>
        </div>

      </div>

<!-- ══════════════════════════════════════════════════════
           ANÁLISIS AVANZADO  –  Ventas · Productos · ML
      ════════════════════════════════════════════════════════ -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-8">

        <!-- Encabezado -->
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-gray-900 tracking-tight">Análisis avanzado</h2>
            <p class="text-sm text-gray-500 mt-0.5">Ventas · Productos · Machine Learning</p>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-100">IA & DATA</span>
        </div>

        <!-- Tabs -->
        <div class="flex gap-2 flex-wrap mb-6" role="tablist">
          <button id="adv-tab-ventas"    class="adv-tab adv-tab--active" onclick="advTab(this,'ventas')">Ventas</button>
          <button id="adv-tab-productos" class="adv-tab"                 onclick="advTab(this,'productos')">Productos</button>
          <button id="adv-tab-ml"        class="adv-tab"                 onclick="advTab(this,'ml')">Machine Learning</button>
        </div>

        <!-- ── TAB: VENTAS ── -->
        <div id="adv-panel-ventas" class="adv-panel adv-panel--active">
          <!-- KPIs -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Total vendido</span>
              <span class="text-lg font-bold text-gray-900">
                S/<%= statsVentas ? parseFloat(statsVentas.total_monto).toLocaleString('es-PE', {minimumFractionDigits:2}) : '0.00' %>
              </span>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Ticket promedio</span>
              <span class="text-lg font-bold text-gray-900" id="adv-stat-avg">—</span>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Venta mayor</span>
              <span class="text-lg font-bold text-gray-900" id="adv-stat-max">—</span>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Productos activos</span>
              <span class="text-lg font-bold text-gray-900"><%= totalProductos %></span>
            </div>
          </div>
          <p class="text-xs font-semibold text-gray-500 mb-2">Monto por cliente</p>
          <div id="advChartVentas" class="w-full" style="height:220px;min-height:220px;max-height:220px;overflow:hidden"></div>
          <p class="text-xs font-semibold text-gray-500 mt-5 mb-2">Distribución por rango</p>
          <div id="advChartDist" class="w-full" style="height:200px;min-height:200px;max-height:200px;overflow:hidden"></div>
        </div>

        <!-- ── TAB: PRODUCTOS ── -->
        <div id="adv-panel-productos" class="adv-panel">
          <p class="text-xs font-semibold text-gray-500 mb-2">Ingresos por categoría</p>
          <div id="advChartCat" class="w-full" style="height:240px;min-height:240px;max-height:240px;overflow:hidden"></div>
          <p class="text-xs font-semibold text-gray-500 mt-5 mb-2">Precio vs. stock actual</p>
          <div id="advChartScatter" class="w-full" style="height:240px;min-height:240px;max-height:240px;overflow:hidden"></div>
          <p class="text-xs font-semibold text-gray-500 mt-5 mb-2">Productos más vendidos (unidades)</p>
          <div id="advChartTopProd" class="w-full" style="height:260px;min-height:260px;overflow:hidden"></div>
        </div>

        <!-- ── TAB: MACHINE LEARNING ── -->
        <div id="adv-panel-ml" class="adv-panel">
          <!-- Métricas RFM -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Clientes VIP</span>
              <span class="text-lg font-bold text-violet-600" id="adv-rfm-vip">—</span>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Frecuentes</span>
              <span class="text-lg font-bold text-emerald-600" id="adv-rfm-freq">—</span>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Ocasionales</span>
              <span class="text-lg font-bold text-gray-500" id="adv-rfm-ocas">—</span>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-1">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Prod. en riesgo</span>
              <span class="text-lg font-bold text-red-500" id="adv-stock-risk">—</span>
            </div>
          </div>

          <p class="text-xs font-semibold text-gray-500 mb-1">Riesgo de agotamiento de stock</p>
          <div class="flex gap-3 text-[11px] text-gray-400 mb-2">
            <span><span class="inline-block w-2 h-2 rounded-sm bg-red-500 mr-1"></span>Crítico ≤5</span>
            <span><span class="inline-block w-2 h-2 rounded-sm bg-amber-500 mr-1"></span>Alerta ≤10</span>
            <span><span class="inline-block w-2 h-2 rounded-sm bg-emerald-500 mr-1"></span>OK &gt;10</span>
          </div>
          <div id="advChartStockRisk" class="w-full mb-6" style="height:260px;min-height:260px;overflow:hidden"></div>

          <p class="text-xs font-semibold text-gray-500 mb-1">Segmentación RFM de clientes</p>
          <div class="flex gap-3 text-[11px] text-gray-400 mb-2">
            <span><span class="inline-block w-2 h-2 rounded-sm bg-violet-500 mr-1"></span>VIP &gt;S/5000</span>
            <span><span class="inline-block w-2 h-2 rounded-sm bg-emerald-500 mr-1"></span>Frecuente S/2000–5000</span>
