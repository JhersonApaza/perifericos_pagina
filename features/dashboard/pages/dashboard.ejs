<%
  const statTotal = usuarios.length;
  let statOtp = 0, statRostro = 0;
  for (const u of usuarios) {
    if (u.otp_activo) statOtp++;
    if (u.tiene_rostro) statRostro++;
  }
  const totalVentas = statsVentas ? parseInt(statsVentas.total_ventas) : 0;
  const totalMonto = statsVentas ? parseFloat(statsVentas.total_monto).toFixed(2) : '0.00';
  const bootstrapData = JSON.stringify({ toastOk: toast_ok, toastWarn: toast_warn, labelsDia, dataDia, labelsTipo, dataTipo });
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard Analítico | Periféricos</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/custom.css">
  <script src="/vendor/apexcharts/apexcharts.min.js"></script>
</head>
<body class="bg-gray-50 font-sans text-gray-900 overflow-hidden flex h-screen selection:bg-indigo-200">
  
  <%- include('../../../shared/components/loader') %>
  <div id="toast-container" class="fixed top-6 right-6 z-50 flex flex-col gap-3"></div>

  <!-- Sidebar -->
  <aside class="w-64 bg-gray-900 text-white flex flex-col hidden lg:flex shadow-2xl relative z-20">
    <div class="h-20 flex items-center px-8 border-b border-gray-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center font-bold text-xl shadow-lg shadow-indigo-500/20">PA</div>
        <span class="font-bold text-lg tracking-tight">Periféricos</span>
      </div>
    </div>
    
    <div class="flex-1 overflow-y-auto py-8 px-4">
      <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Menú Principal</p>
      <nav class="space-y-2">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-600 text-white shadow-md shadow-indigo-600/20 transition-all font-medium">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          Dashboard
        </a>
        <a href="/ventas" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-gray-800 hover:text-white transition-all font-medium group">
          <svg class="w-5 h-5 group-hover:text-emerald-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          Punto de Venta
        </a>
      </nav>
      
      <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-widest mt-10 mb-4">Cuenta</p>
      <nav class="space-y-2">
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-red-500/10 hover:text-red-400 transition-all font-medium group">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Cerrar Sesión
        </a>
      </nav>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
    
    <!-- Topbar -->
    <header class="h-20 bg-white/80 backdrop-blur-md border-b border-gray-200 flex items-center justify-between px-8 sticky top-0 z-10">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Bienvenido, <%= nombreUsuario %></h1>
        <p class="text-sm text-gray-500 font-medium mt-0.5">Ventas · Usuarios · Seguridad</p>
      </div>
      <div class="flex items-center gap-4">
        <a href="/ventas" class="px-5 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-xl shadow-md shadow-emerald-600/20 hover:bg-emerald-500 hover:-translate-y-0.5 transition-all flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Nueva Venta
        </a>
      </div>
    </header>

    <!-- Content Area -->
    <main class="flex-1 overflow-y-auto p-8 bg-gray-50/50">
      
      <!-- KPIs -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
        <!-- KPI 1 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500"><%= es_admin ? 'Trabajadores' : 'Cuenta' %></p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= es_admin ? statTotal : 1 %></h3>
          </div>
        </div>
        
        <!-- KPI 2 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-amber-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500">Total Ventas</p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= totalVentas %></h3>
          </div>
        </div>

        <!-- KPI 3 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500">Monto Total (S/.)</p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= totalMonto %></h3>
          </div>
        </div>

        <!-- KPI 4 -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-5 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 rounded-full bg-purple-50 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500">Enrolamiento Facial</p>
            <h3 class="text-3xl font-bold text-gray-900 mt-1"><%= statRostro %></h3>
          </div>
        </div>
      </div>

      <!-- Main Charts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Ventas por Día</h3>
              <p class="text-sm text-gray-500">Monto total (S/.) — últimos 30 días</p>
            </div>
            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full border border-indigo-100">Tendencia</span>
          </div>
          <div id="chartDias" class="flex-1 min-h-[280px] w-full"></div>
          <p id="emptyDias" class="text-center text-gray-400 py-10 hidden">No hay ventas registradas en este periodo.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Ventas por Categoría</h3>
              <p class="text-sm text-gray-500">Distribución por monto — 30 días</p>
            </div>
            <span class="px-3 py-1 bg-amber-50 text-amber-700 text-xs font-semibold rounded-full border border-amber-100">Distribución</span>
          </div>
          <div id="chartTipos" class="flex-1 min-h-[280px] w-full flex items-center justify-center"></div>
          <p id="emptyTipos" class="text-center text-gray-400 py-10 hidden">Sin ventas por categoría en este periodo.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-6">
        
        <!-- Pareto -->
        <div class="xl:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-4 gap-4">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Curva ABC — Ingresos</h3>
              <p class="text-sm text-gray-500">Últimos 90 días</p>
            </div>
            <div class="flex items-center gap-3 text-xs font-medium text-gray-600">
              <span class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-sm bg-emerald-500"></div>A (0-80%)</span>
              <span class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-sm bg-amber-500"></div>B (80-95%)</span>
              <span class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-sm bg-red-500"></div>C (95-100%)</span>
            </div>
          </div>
          <% if (pareto && pareto.length > 0) { %>
            <div id="chartPareto" class="flex-1 min-h-[300px] w-full"></div>
          <% } else { %>
            <p class="text-center text-gray-400 py-16">Sin datos de ventas aún.</p>
          <% } %>
        </div>

        <!-- Ranking -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Ranking</h3>
              <p class="text-sm text-gray-500">Trabajadores (30d)</p>
            </div>
          </div>
          <% if (ranking && ranking.length > 0) { %>
            <div id="chartRanking" class="flex-1 min-h-[300px] w-full"></div>
          <% } else { %>
            <p class="text-center text-gray-400 py-16">Sin datos de ventas aún.</p>
          <% } %>
        </div>
      </div>

      <!-- Heatmap & Stock -->
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-6">
        
        <!-- Heatmap (Vanilla JS) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="mb-4">
            <h3 class="text-lg font-bold text-gray-900">Concentración de Ventas</h3>
            <p class="text-sm text-gray-500">Heatmap por hora y día — últimos 60 días</p>
          </div>
          <div class="overflow-x-auto pb-2">
            <div id="heatmap-container" class="grid gap-[3px] min-w-[680px]" style="grid-template-columns: 44px repeat(24, 1fr);"></div>
            <div class="flex justify-end items-center gap-2 mt-3 text-xs text-gray-500 font-medium">
              <span>Menos</span>
              <div id="heatmap-legend" class="flex gap-0.5"></div>
              <span>Más</span>
            </div>
            <p id="heatmap-empty" class="text-center text-gray-400 py-10 hidden">Sin datos suficientes aún.</p>
          </div>
        </div>

        <!-- Stock -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="mb-4">
            <h3 class="text-lg font-bold text-gray-900">Stock Crítico</h3>
            <p class="text-sm text-gray-500">Productos con pocos días de inventario</p>
          </div>
          <% if (stockAlertas && stockAlertas.length > 0) { %>
            <div id="chartStock" class="w-full min-h-[220px]"></div>
          <% } else { %>
            <div class="flex flex-col items-center justify-center py-10 text-emerald-500">
              <svg class="w-12 h-12 mb-3 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <p class="font-medium">Sin productos en stock crítico. ¡Todo bien!</p>
            </div>
          <% } %>
        </div>

      </div>

      <!-- Data Table -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-10">
        <div class="p-6 border-b border-gray-100 bg-gray-50/50">
          <h3 class="text-lg font-bold text-gray-900">Trabajadores Registrados</h3>
          <p class="text-sm text-gray-500"><%= statTotal %> cuenta(s) en total</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-white text-xs uppercase tracking-wider text-gray-500 font-semibold border-b border-gray-100">
                <th class="px-6 py-4">ID</th>
                <th class="px-6 py-4">Usuario</th>
                <th class="px-6 py-4">Correo</th>
                <th class="px-6 py-4">Registro</th>
                <th class="px-6 py-4">OTP</th>
                <th class="px-6 py-4">Rostro</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
              <% for (const u of usuarios) { %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 font-mono text-gray-500">#<%= u.id %></td>
                <td class="px-6 py-4 font-medium text-gray-900"><%= u.usuario %></td>
                <td class="px-6 py-4 text-gray-600"><%= u.correo || '—' %></td>
                <td class="px-6 py-4 text-gray-600"><%= u.fecha_registro || '—' %></td>
                <td class="px-6 py-4">
                  <% if (u.otp_activo) { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Activo</span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Inactivo</span>
                  <% } %>
                </td>
                <td class="px-6 py-4">
                  <% if (u.tiene_rostro) { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200"><span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> Sí</span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> No</span>
                  <% } %>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <!-- Data payloads -->
  <script type="application/json" id="dashboard-bootstrap"><%- bootstrapData %></script>
  <script type="application/json" id="pareto-data"><%- JSON.stringify(pareto || []) %></script>
  <script type="application/json" id="heatmap-data"><%- JSON.stringify(heatmap || []) %></script>
  <script type="application/json" id="ranking-data"><%- JSON.stringify(ranking || []) %></script>
  <script type="application/json" id="stock-data"><%- JSON.stringify(stockAlertas || []) %></script>
  
  <script src="/js/dashboard/dashboard.js"></script>

  <!-- Heatmap (Vanilla JS) re-integrado -->
  <script>
    (function () {
      var raw = [];
      try { raw = JSON.parse(document.getElementById('heatmap-data').textContent || '[]'); } catch(e){}
      var container = document.getElementById('heatmap-container');
      var emptyMsg  = document.getElementById('heatmap-empty');
      if (!raw.length) {
        if(container) container.style.display = 'none';
        if(emptyMsg) emptyMsg.style.display  = 'block';
        return;
      }
      var dias = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
      var mapa = {}; var maxVal = 0;
      raw.forEach(function(r) {
        var d = parseInt(r.dia_semana), h = parseInt(r.hora), v = parseInt(r.total_ventas);
        if (!mapa[d]) mapa[d] = {};
        mapa[d][h] = (mapa[d][h] || 0) + v;
        if (mapa[d][h] > maxVal) maxVal = mapa[d][h];
      });
      if(!container) return;
      var hd = document.createElement('div');
      hd.className = 'text-[10px] text-gray-400 flex items-center font-medium';
      hd.textContent = 'Hora→';
      container.appendChild(hd);
      for (var h = 0; h < 24; h++) {
        var ch = document.createElement('div');
        ch.className = 'text-[9px] text-center text-gray-400 font-medium';
        ch.textContent = h;
        container.appendChild(ch);
      }
      for (var d = 1; d <= 7; d++) {
        var lbl = document.createElement('div');
        lbl.className = 'text-[11px] font-semibold text-gray-700 flex items-center';
        lbl.textContent = dias[d-1];
        container.appendChild(lbl);
        for (var h2 = 0; h2 < 24; h2++) {
          var val = (mapa[d] && mapa[d][h2]) ? mapa[d][h2] : 0;
          var intens = maxVal > 0 ? val / maxVal : 0;
          var cel = document.createElement('div');
          cel.className = 'h-5 rounded-[3px] transition-colors hover:ring-2 hover:ring-indigo-300';
          cel.style.backgroundColor = 'rgba(79, 70, 229, ' + (intens * 0.85 + (intens > 0 ? 0.15 : 0.05)).toFixed(2) + ')';
          cel.title = dias[d-1] + ' ' + h2 + ':00 — ' + val + ' venta(s)';
          container.appendChild(cel);
        }
      }
      var legend = document.getElementById('heatmap-legend');
      if (legend) {
        for (var i = 0; i <= 5; i++) {
          var s = document.createElement('span');
          var a = i === 0 ? 0.05 : (i / 5 * 0.85 + 0.15).toFixed(2);
          s.className = 'inline-block w-4 h-2.5 rounded-[2px]';
          s.style.backgroundColor = 'rgba(79, 70, 229, ' + a + ')';
          legend.appendChild(s);
        }
      }
    })();
  </script>
</body>
</html>
