<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Error <%= statusCode %> | Periféricos</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="h-screen w-screen bg-gray-950 font-sans text-white overflow-hidden flex items-center justify-center relative selection:bg-indigo-500/30">

  <!-- Background decorative blobs -->
  <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-gradient-to-br from-red-600/20 via-pink-900/10 to-transparent rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-gradient-to-tl from-indigo-600/20 via-purple-900/10 to-transparent rounded-full blur-[100px] pointer-events-none"></div>

  <div class="w-full max-w-lg p-8 sm:p-12 text-center relative z-10">
    <div class="glass-panel p-10 rounded-3xl border border-white/10 shadow-2xl relative overflow-hidden bg-white/5 backdrop-blur-xl">
      <!-- Glow effect behind code -->
      <div class="absolute top-10 left-1/2 -translate-x-1/2 w-40 h-40 bg-indigo-500/10 rounded-full blur-[50px] pointer-events-none"></div>

      <!-- Icon/Status -->
      <h1 class="text-8xl sm:text-9xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-pink-500 to-indigo-500 drop-shadow-sm select-none">
        <%= statusCode %>
      </h1>

      <h2 class="text-2xl font-bold text-white mt-6 tracking-tight">Algo no salió como esperábamos</h2>
      
      <p class="text-gray-400/90 text-sm mt-3 leading-relaxed max-w-sm mx-auto font-light">
        <%= message %>
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="px-6 py-3.5 rounded-xl bg-white text-gray-950 font-semibold shadow-xl hover:bg-gray-100 hover-lift transition-all text-sm">
          Ir al Inicio
        </a>
        <a href="javascript:history.back()" class="px-6 py-3.5 rounded-xl bg-white/10 text-white font-semibold border border-white/10 hover:bg-white/20 hover-lift transition-all text-sm">
          Atrás
        </a>
      </div>
    </div>
  </div>

  <style>
    .glass-panel {
      background: rgba(255, 255, 255, 0.03) !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
  </style>
</body>
</html>
