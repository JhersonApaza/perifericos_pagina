{
  "name": "pa-node",
  "version": "1.0.0",
  "description": "Sistema de autenticación con OTP y reconocimiento facial - Node.js",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/tailwind.css",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/tailwind.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"nodemon --no-warnings app.js\""
  },
  "dependencies": {
    "apexcharts": "^5.13.0",
    "bcryptjs": "^2.4.3",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.18.3",
    "express-session": "^1.18.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.19"
  }
}
