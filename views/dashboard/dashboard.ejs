<%
  const statTotal = usuarios.length;
  let statOtp = 0, statRostro = 0;
  for (const u of usuarios) {
    if (u.otp_activo) statOtp++;
    if (u.tiene_rostro) statRostro++;
  }
  const totalVentas = statsVentas ? parseInt(statsVentas.total_ventas) : 0;
  const totalMonto = statsVentas ? parseFloat(statsVentas.total_monto).toFixed(2) : '0.00';
  const bootstrapData = JSON.stringify({ toastOk: toast_ok, toastWarn: toast_warn, labelsDia, dataDia, labelsTipo, dataTipo });
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard analítico</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body class="dash-page">
  <div id="toast-container" class="toast-container" aria-live="polite"></div>

  <header class="dash-topbar">
    <div class="dash-topbar-brand">
      <span class="dash-topbar-logo" aria-hidden="true">PA</span>
      <div>
        <span class="dash-topbar-title">Bienvenido, <%= nombreUsuario %></span>
        <span class="dash-topbar-sub">Ventas · Usuarios · Seguridad</span>
      </div>
    </div>
      <div class="dash-topbar-actions">
        <a href="/ventas" class="dash-topbar-link dash-topbar-link--primary" style="background:#1D9E75;border-color:#1D9E75">Nueva venta</a>
        <a href="/" class="dash-topbar-link">Inicio sesión</a>
        <a href="/logout" class="dash-topbar-link dash-topbar-link--primary">Cerrar sesión</a>
      </div>
  </header>

  <main class="dash-main dash-main--wide">
    <section class="dash-hero">
      <div class="dash-hero-inner">
        <p class="dash-kicker">Resumen del sistema</p>
        <h1 class="dash-title">Ventas y usuarios</h1>
        <p class="dash-desc">Visualiza el rendimiento de ventas por día y por categoría de producto en los últimos 30 días.</p>
      </div>
    </section>

    <div class="dash-stats">
      <div class="dash-stat dash-stat--violet">
        <div class="dash-stat-label"><%= es_admin ? 'Trabajadores' : 'Cuenta' %></div>
        <div class="dash-stat-value"><%= es_admin ? statTotal : 1 %></div>
      </div>
      <div class="dash-stat dash-stat--amber">
        <div class="dash-stat-label">Total ventas</div>
        <div class="dash-stat-value"><%= totalVentas %></div>
      </div>
      <div class="dash-stat dash-stat--green">
        <div class="dash-stat-label">Monto total (S/.)</div>
        <div class="dash-stat-value"><%= totalMonto %></div>
      </div>
      <div class="dash-stat">
        <div class="dash-stat-label">Con rostro</div>
        <div class="dash-stat-value"><%= statRostro %></div>
      </div>
    </div>

    <!-- Gráficos originales -->
    <div class="dash-grid-charts">
      <section class="dash-panel dash-chart-card">
        <div class="dash-chart-head">
          <div>
          <h2 class="dash-section-title">Ventas por día</h2>
          <p class="dash-section-hint">Monto total (S/.) — últimos 30 días</p>
          </div>
          <span class="dash-chart-badge">Línea de tiempo</span>
        </div>
        <div class="dash-chart-body">
          <canvas id="chartDias" height="220"></canvas>
          <p class="dash-chart-empty" id="emptyDias" hidden>No hay ventas registradas en este periodo.</p>
        </div>
      </section>
      <section class="dash-panel dash-chart-card">
        <div class="dash-chart-head">
          <div>
          <h2 class="dash-section-title">Ventas por categoría</h2>
          <p class="dash-section-hint">Distribución por monto (S/.) — 30 días</p>
          </div>
          <span class="dash-chart-badge">Distribución</span>
        </div>
        <div class="dash-chart-body">
          <canvas id="chartTipos" height="220"></canvas>
          <p class="dash-chart-empty" id="emptyTipos" hidden>Sin ventas por categoría en este periodo.</p>
        </div>
      </section>
    </div>

    <!-- Pareto ABC -->
    <section class="dash-panel dash-chart-card">
      <div class="dash-chart-head">
        <div>
          <h2 class="dash-section-title">Curva ABC — Productos por ingreso</h2>
          <p class="dash-section-hint">Últimos 90 días</p>
        </div>
        <div style="display:flex;gap:12px;font-size:.75rem;align-items:center">
          <span style="display:flex;align-items:center;gap:4px">
            <span style="width:10px;height:10px;border-radius:2px;background:#22c55e;display:inline-block"></span>A (0–80%)
          </span>
          <span style="display:flex;align-items:center;gap:4px">
            <span style="width:10px;height:10px;border-radius:2px;background:#f59e0b;display:inline-block"></span>B (80–95%)
          </span>
          <span style="display:flex;align-items:center;gap:4px">
            <span style="width:10px;height:10px;border-radius:2px;background:#ef4444;display:inline-block"></span>C (95–100%)
          </span>
          <span style="display:flex;align-items:center;gap:4px">
            <span style="width:10px;height:3px;background:#a78bfa;display:inline-block;border-radius:2px"></span>% acum.
          </span>
        </div>
      </div>
      <div class="dash-chart-body" style="position:relative;height:280px">
        <% if (pareto && pareto.length > 0) { %>
          <canvas id="chartPareto" role="img" aria-label="Pareto ABC de productos">Gráfico Pareto de productos por ingreso.</canvas>
        <% } else { %>
          <p style="text-align:center;opacity:.5;padding:2rem 0">Sin datos de ventas aún.</p>
        <% } %>
      </div>
    </section>

    <!-- Heatmap -->
    <section class="dash-panel dash-chart-card">
      <div class="dash-chart-head">
        <div>
          <h2 class="dash-section-title">Heatmap de ventas</h2>
          <p class="dash-section-hint">Concentración por hora y día — últimos 60 días</p>
        </div>
        <span class="dash-chart-badge">Heatmap</span>
      </div>
      <div style="overflow-x:auto;padding:0 0 .5rem">
        <div id="heatmap-container" style="display:grid;grid-template-columns:44px repeat(24,1fr);gap:3px;min-width:680px"></div>
        <div style="display:flex;justify-content:flex-end;align-items:center;gap:5px;margin-top:6px;font-size:11px;opacity:.5">
          <span>Menos</span>
          <span id="heatmap-legend"></span>
          <span>Más</span>
        </div>
        <p id="heatmap-empty" style="text-align:center;opacity:.5;display:none">Sin datos suficientes aún.</p>
      </div>
    </section>

    <!-- Ranking trabajadores -->
    <section class="dash-panel dash-chart-card">
      <div class="dash-chart-head">
        <div>
          <h2 class="dash-section-title">Ranking de trabajadores</h2>
          <p class="dash-section-hint">Últimos 30 días</p>
        </div>
        <span class="dash-chart-badge">Ranking</span>
      </div>
      <div class="dash-chart-body" style="position:relative;height:160px">
        <% if (ranking && ranking.length > 0) { %>
          <canvas id="chartRanking" role="img" aria-label="Ranking de ventas por trabajador">Ranking de ventas de los trabajadores.</canvas>
        <% } else { %>
          <p style="text-align:center;opacity:.5;padding:2rem 0">Sin datos de ventas aún.</p>
        <% } %>
      </div>
    </section>

    <!-- Stock crítico -->
    <section class="dash-panel dash-chart-card">
      <div class="dash-chart-head">
        <div>
          <h2 class="dash-section-title">Stock crítico</h2>
          <p class="dash-section-hint">Productos con menos de 15 días de inventario según velocidad de venta</p>
        </div>
        <div style="display:flex;gap:12px;font-size:.75rem;align-items:center">
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#ef4444;display:inline-block"></span>Crítico ≤5d</span>
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#f59e0b;display:inline-block"></span>Alerta ≤10d</span>
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#eab308;display:inline-block"></span>Bajo ≤15d</span>
        </div>
      </div>
      <div class="dash-chart-body" style="position:relative;height:200px">
        <% if (stockAlertas && stockAlertas.length > 0) { %>
          <canvas id="chartStock" role="img" aria-label="Stock crítico de productos">Productos con stock bajo.</canvas>
        <% } else { %>
          <p style="text-align:center;opacity:.5;padding:2rem 0">Sin productos en stock crítico. ¡Todo bien!</p>
        <% } %>
      </div>
    </section>


    <!-- SECCIÓN ML CON TABS -->
<section class="dash-panel dash-chart-card dash-ml-section">
  <div class="dash-chart-head" style="margin-bottom:.75rem">
    <div>
      <h2 class="dash-section-title">Análisis avanzado</h2>
      <p class="dash-section-hint">Ventas · Productos · Machine Learning</p>
    </div>
    <span class="dash-chart-badge">IA & Data</span>
  </div>

  <!-- Tabs -->
  <div class="ml-tabs" role="tablist">
    <button class="ml-tab ml-tab--active" data-tab="ventas"   onclick="mlTab(this,'ventas')">Ventas</button>
    <button class="ml-tab"                data-tab="productos" onclick="mlTab(this,'productos')">Productos</button>
    <button class="ml-tab"                data-tab="ml"        onclick="mlTab(this,'ml')">Machine Learning</button>
  </div>

  <!-- Tab: Ventas -->
  <div id="ml-tab-ventas" class="ml-panel ml-panel--active">
    <div class="ml-metrics">
      <div class="ml-metric"><span class="ml-metric-lbl">Total vendido</span><span class="ml-metric-val" id="ml-stat-total">S/<%= statsVentas ? parseFloat(statsVentas.total_monto).toLocaleString('es-PE') : '0' %></span></div>
      <div class="ml-metric"><span class="ml-metric-lbl">Ticket promedio</span><span class="ml-metric-val" id="ml-stat-avg">—</span></div>
      <div class="ml-metric"><span class="ml-metric-lbl">Venta mayor</span><span class="ml-metric-val" id="ml-stat-max">—</span></div>
      <div class="ml-metric"><span class="ml-metric-lbl">Productos activos</span><span class="ml-metric-val"><%= totalProductos %></span></div>
    </div>
    <p style="font-size:.75rem;color:var(--dash-muted);margin:.75rem 0 .5rem">Monto por cliente</p>
    <div style="position:relative;height:220px">
      <canvas id="mlChartVentas" role="img" aria-label="Total por venta">Barras de monto por cliente.</canvas>
    </div>
    <p style="font-size:.75rem;color:var(--dash-muted);margin:.9rem 0 .5rem">Distribución por rango</p>
    <div style="position:relative;height:200px">
      <canvas id="mlChartDist" role="img" aria-label="Distribución por rango">Donut de rangos.</canvas>
    </div>
  </div>

  <!-- Tab: Productos -->
  <div id="ml-tab-productos" class="ml-panel">
    <p style="font-size:.75rem;color:var(--dash-muted);margin:0 0 .5rem">Ingresos por categoría</p>
    <div style="position:relative;height:240px">
      <canvas id="mlChartCat" role="img" aria-label="Ingresos por categoría">Barras por categoría.</canvas>
    </div>
    <p style="font-size:.75rem;color:var(--dash-muted);margin:.9rem 0 .5rem">Precio vs. stock actual</p>
    <div style="position:relative;height:240px">
      <canvas id="mlChartScatter" role="img" aria-label="Precio vs stock">Dispersión precio-stock.</canvas>
    </div>
    <p style="font-size:.75rem;color:var(--dash-muted);margin:.9rem 0 .5rem">Productos más vendidos (unidades)</p>
    <div style="position:relative;height:260px">
      <canvas id="mlChartTopProd" role="img" aria-label="Top productos">Horizontal bars.</canvas>
    </div>
  </div>

<!-- Tab: Machine Learning -->
<div id="ml-tab-ml" class="ml-panel">

  <!-- Métricas rápidas -->
  <div class="ml-metrics" style="margin-bottom:1rem">
    <div class="ml-metric"><span class="ml-metric-lbl">Clientes VIP</span><span class="ml-metric-val" id="ml-rfm-vip" style="color:#8b5cf6">—</span></div>
    <div class="ml-metric"><span class="ml-metric-lbl">Frecuentes</span><span class="ml-metric-val" id="ml-rfm-freq" style="color:#22c55e">—</span></div>
    <div class="ml-metric"><span class="ml-metric-lbl">Ocasionales</span><span class="ml-metric-val" id="ml-rfm-ocas" style="color:#a1a1aa">—</span></div>
    <div class="ml-metric"><span class="ml-metric-lbl">Prod. en riesgo</span><span class="ml-metric-val" id="ml-stock-risk" style="color:#ef4444">—</span></div>
  </div>

  <!-- Gráfico 1: Riesgo de stock -->
  <p style="font-size:.75rem;color:var(--dash-muted);margin:0 0 .4rem">Riesgo de agotamiento de stock</p>
  <div style="display:flex;gap:12px;font-size:.72rem;color:var(--dash-muted);margin-bottom:.5rem">
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:#ef4444;margin-right:3px"></span>Crítico ≤5</span>
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:#f59e0b;margin-right:3px"></span>Alerta ≤10</span>
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:#22c55e;margin-right:3px"></span>OK &gt;10</span>
  </div>
  <div style="position:relative;height:260px;margin-bottom:1.5rem">
    <canvas id="mlChartStockRisk" role="img" aria-label="Riesgo de agotamiento por producto">Stock actual vs vendidos.</canvas>
  </div>

  <!-- Gráfico 2: Segmentación RFM -->
  <p style="font-size:.75rem;color:var(--dash-muted);margin:0 0 .4rem">Segmentación RFM de clientes</p>
  <div style="display:flex;gap:12px;font-size:.72rem;color:var(--dash-muted);margin-bottom:.5rem">
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:#8b5cf6;margin-right:3px"></span>VIP &gt;S/5000</span>
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:#22c55e;margin-right:3px"></span>Frecuente S/2000–5000</span>
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:#a1a1aa;margin-right:3px"></span>Ocasional &lt;S/2000</span>
  </div>
  <div style="position:relative;height:220px;margin-bottom:1.5rem">
    <canvas id="mlChartRFM" role="img" aria-label="Segmentación RFM de clientes">Barras de monto por cliente.</canvas>
  </div>

  <!-- Gráficos 3 y 4 en grid -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem">
    <div>
      <p style="font-size:.75rem;color:var(--dash-muted);margin:0 0 .4rem">Proyección de ventas</p>
      <div style="display:flex;gap:10px;font-size:.72rem;color:var(--dash-muted);margin-bottom:.5rem">
        <span><span style="display:inline-block;width:9px;height:3px;background:#8b5cf6;margin-right:3px;border-radius:2px"></span>Reales</span>
        <span><span style="display:inline-block;width:9px;height:3px;background:#34d399;margin-right:3px;border-radius:2px;border:1px dashed #34d399"></span>Proyección</span>
      </div>
      <div style="position:relative;height:180px">
        <canvas id="mlChartProyec" role="img" aria-label="Proyección de ventas">Línea de proyección.</canvas>
      </div>
    </div>
    <div>
      <p style="font-size:.75rem;color:var(--dash-muted);margin:0 0 .4rem">Distribución ABC productos</p>
      <div style="position:relative;height:180px">
        <canvas id="mlChartABC" role="img" aria-label="Distribución ABC">Donut ABC.</canvas>
      </div>
    </div>
  </div>

</div>
</section>

    <!-- Tabla de trabajadores -->
    <section class="dash-panel dash-panel--table">
      <div class="dash-table-head-row">
        <div>
          <h2 class="dash-section-title">Trabajadores registrados</h2>
          <p class="dash-section-hint"><%= statTotal %> cuenta(s) en total</p>
        </div>
      </div>
      <div class="table-wrap">
        <table class="dash-table">
          <thead>
            <tr><th>ID</th><th>Usuario</th><th>Correo</th><th>Registro</th><th>OTP</th><th>Rostro</th></tr>
          </thead>
          <tbody>
            <% for (const u of usuarios) { %>
            <tr>
              <td class="dash-id"><%= u.id %></td>
              <td><%= u.usuario %></td>
              <td><%= u.correo || '' %></td>
              <td><%= u.fecha_registro || '—' %></td>
              <td><% if (u.otp_activo) { %><span class="dash-badge dash-badge--yes">Activo</span><% } else { %><span class="dash-badge dash-badge--no">No</span><% } %></td>
              <td><% if (u.tiene_rostro) { %><span class="dash-badge dash-badge--yes">Sí</span><% } else { %><span class="dash-badge dash-badge--no">No</span><% } %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="dash-footer">
        <a href="/" class="dash-btn dash-btn--ghost">Volver al inicio de sesión</a>
      </div>
    </section>
  </main>

  <!-- Datos bootstrap -->
  <script type="application/json" id="dashboard-bootstrap"><%- bootstrapData %></script>

  <!-- Datos nuevos gráficos -->
  <script type="application/json" id="pareto-data"><%- JSON.stringify(pareto || []) %></script>
  <script type="application/json" id="heatmap-data"><%- JSON.stringify(heatmap || []) %></script>
  <script type="application/json" id="ranking-data"><%- JSON.stringify(ranking || []) %></script>
  <script type="application/json" id="stock-data"><%- JSON.stringify(stockAlertas || []) %></script>
  <script type="application/json" id="ml-clientes-data"><%- mlClientes %></script>
  <script type="application/json" id="ml-topproductos-data"><%- mlTopProductos %></script>
  <script type="application/json" id="ml-preciostock-data"><%- mlPrecioStock %></script>
  <script src="/js/dashboard.js"></script>

  <!-- Heatmap (vanilla JS) -->
  <script>
  (function () {
    var raw = [];
    try { raw = JSON.parse(document.getElementById('heatmap-data').textContent || '[]'); } catch(e){}
    var container = document.getElementById('heatmap-container');
    var emptyMsg  = document.getElementById('heatmap-empty');
    if (!raw.length) {
      container.style.display = 'none';
      emptyMsg.style.display  = 'block';
      return;
    }
    var dias = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    var mapa = {}; var maxVal = 0;
    raw.forEach(function(r) {
      var d = parseInt(r.dia_semana), h = parseInt(r.hora), v = parseInt(r.total_ventas);
      if (!mapa[d]) mapa[d] = {};
      mapa[d][h] = (mapa[d][h] || 0) + v;
      if (mapa[d][h] > maxVal) maxVal = mapa[d][h];
    });
    var hd = document.createElement('div');
    hd.style.cssText = 'font-size:10px;opacity:.4;display:flex;align-items:center';
    hd.textContent = 'Hora→';
    container.appendChild(hd);
    for (var h = 0; h < 24; h++) {
      var ch = document.createElement('div');
      ch.style.cssText = 'font-size:9px;text-align:center;opacity:.4';
      ch.textContent = h;
      container.appendChild(ch);
    }
    for (var d = 1; d <= 7; d++) {
      var lbl = document.createElement('div');
      lbl.style.cssText = 'font-size:11px;font-weight:600;display:flex;align-items:center';
      lbl.textContent = dias[d-1];
      container.appendChild(lbl);
      for (var h2 = 0; h2 < 24; h2++) {
        var val = (mapa[d] && mapa[d][h2]) ? mapa[d][h2] : 0;
        var intens = maxVal > 0 ? val / maxVal : 0;
        var cel = document.createElement('div');
        cel.style.cssText = 'height:20px;border-radius:3px;background:rgba(99,102,241,' + (intens * .85 + (intens > 0 ? .1 : 0)).toFixed(2) + ')';
        cel.title = dias[d-1] + ' ' + h2 + ':00 — ' + val + ' venta(s)';
        container.appendChild(cel);
      }
    }
    var legend = document.getElementById('heatmap-legend');
    if (legend) {
      for (var i = 0; i <= 5; i++) {
        var s = document.createElement('span');
        var a = i === 0 ? 0.05 : (i / 5 * 0.85 + 0.1).toFixed(2);
        s.style.cssText = 'display:inline-block;width:18px;height:10px;border-radius:2px;background:rgba(99,102,241,' + a + ')';
        legend.appendChild(s);
      }
    }
  })();
  </script>
</body>
</html>
