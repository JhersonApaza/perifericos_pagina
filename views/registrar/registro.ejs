<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registro de Usuario</title>
  <link rel="stylesheet" href="/css/registro.css">
  <link rel="stylesheet" href="/css/auth-experience.css">
</head>
<body class="dash-page auth-experience">
  <header class="dash-topbar">
    <div class="dash-topbar-brand">
      <span class="dash-topbar-logo" aria-hidden="true">PA</span>
      <div>
        <span class="dash-topbar-title">Nuevo registro</span>
        <span class="dash-topbar-sub">Cuenta · Rostro · Contraseña segura</span>
      </div>
    </div>
    <div class="dash-topbar-actions">
      <a href="/" class="dash-topbar-link">Iniciar sesión</a>
    </div>
  </header>

  <main class="auth-main auth-main--split">
    <aside class="auth-hero-side">
      <p class="auth-hero-tag">Enrolamiento</p>
      <h1 class="auth-hero-h1">Alta con<br><span>huella visual</span></h1>
      <p class="auth-hero-p">Captura tu rostro una vez, refuerza la cuenta con contraseña fuerte y valida el correo con OTP.</p>
      <ul class="auth-hero-badges">
        <li><span class="auth-hex" aria-hidden="true">01</span> Mapa facial</li>
        <li><span class="auth-hex" aria-hidden="true">02</span> Clave</li>
        <li><span class="auth-hex" aria-hidden="true">03</span> Correo</li>
      </ul>
      <div class="auth-hero-deco" aria-hidden="true"></div>
    </aside>

    <div class="auth-stack">
      <div class="reg-card">
        <p class="reg-kicker">Alta de usuario</p>
        <h2>Crear cuenta</h2>
        <p class="reg-face-intro">Registro con reconocimiento facial: encuadra tu rostro y pulsa <strong>Capturar rostro</strong> antes de enviar el formulario.</p>
        <div class="face-scan-wrap">
          <video id="videoRegistro" class="face-video" playsinline muted></video>
          <canvas id="canvasFaceRegistro" class="face-scan-canvas" aria-hidden="true"></canvas>
        </div>
        <button type="button" class="btn-encender-cam" id="btnEncenderReg">Encender cámara</button>
        <button type="button" class="btn-capture" id="btnCapturarReg">Capturar rostro</button>
        <form id="formRegistro" method="POST" action="/registro">
          <input type="hidden" name="face_descriptor" id="faceDescReg" value="">
          <input type="text" name="usuario" placeholder="Nombre de usuario" required autocomplete="username">
          <input type="email" name="correo" placeholder="Correo electrónico" required autocomplete="email">
          <input type="password" name="password" id="regPassword" placeholder="Nueva Contraseña" required autocomplete="new-password" minlength="8">
          <div class="pwd-meter-wrap">
            <div class="pwd-meter-label">Nivel de seguridad: <span id="pwdMeterText">—</span></div>
            <div class="pwd-meter-bar"><div class="pwd-meter-fill" id="pwdMeterFill"></div></div>
            <p class="pwd-hint">Mínimo 8 caracteres, con mayúsculas, minúsculas y números.</p>
          </div>
          <input type="password" name="confirm_password" placeholder="Confirmar Contraseña" required autocomplete="new-password">
          <button type="submit">Registrarse</button>
        </form>
        <div class="footer-link">¿Ya tienes cuenta? <a href="/">Inicia sesión</a></div>
      </div>
    </div>
  </main>

  <% if (toast_warn) { %>
    <div class="login-toast" role="alert"><%= toast_warn %></div>
  <% } %>
  <% if (toast_ok) { %>
    <div class="login-toast" role="status" style="background:rgba(6,78,59,0.95);color:#d1fae5;border-color:rgba(16,185,129,0.35);text-align:center;"><%= toast_ok %></div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/dist/face-api.min.js"></script>
  <script src="/js/face-auth.js"></script>
  <script src="/js/registro.js"></script>
</body>
</html>
